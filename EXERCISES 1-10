    NUMS  DB 1, 2, 3
DATA ENDS

CODE SEGMENT
    ASSUME CS:CODE, DS:DATA
START:
    MOV AX, DATA
    MOV DS, AX

    MOV AL, 80H
    OUT 86H, AL

