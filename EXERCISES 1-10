    LEA BX, TABLE
    
    MOV AL, [NUMS]
    XLAT
    OUT 80H, AL
    MOV AL, 0FEH
    OUT 82H, AL
    CALL DELAY

    MOV AL, [NUMS+1]
    XLAT
    OUT 80H, AL
    MOV AL, 0FDH
    OUT 82H, AL
    CALL DELAY

    MOV AL, [NUMS+2]
    XLAT
    OUT 80H, AL
    MOV AL, 0FBH
    OUT 82H, AL
    CALL DELAY

    JMP REFRESH

DELAY PROC
    MOV CX, 0500H
D1: LOOP D1
    RET
DELAY ENDP

CODE ENDS
END START

